<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android-only, plain .NET for Android (no MAUI) - single-purpose background sync utility. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.co.accessuk.scalebridge</ApplicationId>
    <ApplicationTitle>ScaleBridge</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Health Connect is built-in on Android 14 (API 34) and available as a separate app back to
         Android 9 (API 28). We target API 26+ at runtime but Health Connect itself needs 28+.
         TargetPlatformVersion is the *compile-time* API level and must match a platform pack the
         restored Android workload actually ships (net10.0-android's workload only ships 35.0/36.0
         - API 34 was dropped) - it does not lower the app's actual minimum supported OS version,
         which is controlled by SupportedOSPlatformVersion below. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <TargetPlatformVersion>35.0</TargetPlatformVersion>

    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <RootNamespace>ScaleBridge</RootNamespace>
    <AssemblyName>ScaleBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard, well-established C# bindings (NotificationCompat, etc.) used for the minimal
         status notification (Prompt.md Section 4, requirement 7). -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.13.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls androidx.health.connect + its transitive Kotlin/coroutines dependencies and generates
         C# bindings automatically. This is the one part of the project most likely to need a small
         adjustment after the first real build - see docs/PROTOCOL_CONFIRMATION.md and
         docs/SETUP.md for details on why, and how to fix binding-name drift if `dotnet build`
         reports missing members here. -->
    <AndroidMavenLibrary Include="androidx.health.connect:connect-client" Version="1.1.0-alpha07" />
  </ItemGroup>

</Project>
