<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly Light, not the DayNight variant: DayNight auto-switches to dark-mode
         defaults (light text/foreground colours, meant for a dark background) whenever the
         phone's system dark mode is on, but every background colour in this app (colors.xml) is
         a single hardcoded light value with no night-mode variants - the mismatch produced
         invisible white-on-white text in input fields on a phone with dark mode enabled. Forcing
         Light avoids the whole light/dark mismatch class of bugs for this small, single-purpose
         screen rather than trying to properly support both.

         Deliberately *not* ".NoActionBar": MainActivity.OnCreateOptionsMenu/OnOptionsItemSelected
         inflate an overflow menu ("Show/hide setup", "Diagnostics") that both existed in code and
         were assumed to be reachable from the moment they were added, but with no ActionBar/
         Toolbar anywhere for the framework to host them, the inflated menu had nowhere to draw
         its 3-dot icon and was completely unreachable in the running app - not a rendering
         glitch, a missing menu-hosting surface. Keeping the plain system ActionBar (rather than
         adding a Toolbar view + switching MainActivity to AppCompatActivity) is the minimal fix:
         MainActivity's existing OnCreateOptionsMenu/OnOptionsItemSelected already assumed a real
         ActionBar/overflow existed and need no further changes to work correctly with one. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
    </style>

    <style name="ScaleBridge.SectionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- parent="" is required on these two: with no explicit parent, Android's build tooling
         auto-derives an implicit parent from everything before the last dot in the style name
         (a convention for organizing unrelated style names alphabetically, not real
         inheritance) - without this, it looked for a non-existent style literally named
         "ScaleBridge" and failed the build ("resource style/ScaleBridge ... not found"). -->
    <!-- Every one of these two styles' usages in activity_main.xml relies on layout_width/
         layout_height coming from the style itself (some <TextView style="..."> tags don't
         specify them directly) - every Android View requires both, from the tag or its style,
         with no default. Omitting them here caused "Binary XML file ...: You must supply a
         layout_width attribute" at runtime (a real crash, not a build-time-caught mistake, since
         AAPT2 doesn't itself flag a style missing these). -->
    <style name="ScaleBridge.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary_variant</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ScaleBridge.BodyText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

    <style name="ScaleBridge.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginTop">8dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="ScaleBridge.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_marginTop">8dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
