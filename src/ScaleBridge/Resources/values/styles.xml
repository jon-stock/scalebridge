<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly Light, not the DayNight variant: DayNight auto-switches to dark-mode
         defaults (light text/foreground colours, meant for a dark background) whenever the
         phone's system dark mode is on, but every background colour in this app (colors.xml) is
         a single hardcoded light value with no night-mode variants - the mismatch produced
         invisible white-on-white text in input fields on a phone with dark mode enabled. Forcing
         Light avoids the whole light/dark mismatch class of bugs for this small, single-purpose
         screen rather than trying to properly support both.

         Back to ".NoActionBar" deliberately, alongside a real <androidx.appcompat.widget.Toolbar>
         in activity_main.xml + MainActivity now extending AppCompatActivity + SetSupportActionBar
         in code (see MainActivity.OnCreate) - this is the only combination that reliably shows an
         overflow menu under any AppCompat/MaterialComponents theme.
         An earlier fix attempt here just dropped ".NoActionBar" (parent="Theme.MaterialComponents.
         Light") on the theory that would restore a plain native ActionBar for OnCreateOptionsMenu/
         OnOptionsItemSelected to host their overflow items on. That compiled and installed fine
         but produced *no visible change whatsoever* - confirmed after a real device test. Root
         cause: every AppCompat-family theme (Theme.AppCompat.*, and therefore
         Theme.MaterialComponents.* too, since it's AppCompat-derived) unconditionally sets
         android:windowActionBar to false and disables the native framework ActionBar entirely,
         regardless of whether ".NoActionBar" is in the theme name or not - that suffix only
         controls a *different*, AppCompat-internal "should a support action bar be created for
         you automatically" flag, which itself only has any effect if the hosting Activity is an
         AppCompatActivity. Since MainActivity was (and had to remain, for RegisterForActivityResult)
         a plain framework/AndroidX ComponentActivity - not AppCompatActivity - there was no
         mechanism left in the theme at all to draw *any* action bar, with or without
         ".NoActionBar". The only correct way to get a working overflow menu under a Material
         theme is the standard, documented one: keep ".NoActionBar" (suppress AppCompat's own
         automatic action bar, since we're hosting our own Toolbar instead), declare a real
         Toolbar widget in the layout, and explicitly call SetSupportActionBar(toolbar) - which
         does require the owning Activity to be AppCompatActivity (see MainActivity.cs; confirmed
         AndroidX.AppCompat.App.AppCompatActivity still supports RegisterForActivityResult, since
         it inherits from AndroidX's own ComponentActivity via FragmentActivity, so no other
         functionality had to be given up to fix this properly). -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
    </style>

    <style name="ScaleBridge.SectionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- parent="" is required on these two: with no explicit parent, Android's build tooling
         auto-derives an implicit parent from everything before the last dot in the style name
         (a convention for organizing unrelated style names alphabetically, not real
         inheritance) - without this, it looked for a non-existent style literally named
         "ScaleBridge" and failed the build ("resource style/ScaleBridge ... not found"). -->
    <!-- Every one of these two styles' usages in activity_main.xml relies on layout_width/
         layout_height coming from the style itself (some <TextView style="..."> tags don't
         specify them directly) - every Android View requires both, from the tag or its style,
         with no default. Omitting them here caused "Binary XML file ...: You must supply a
         layout_width attribute" at runtime (a real crash, not a build-time-caught mistake, since
         AAPT2 doesn't itself flag a style missing these). -->
    <style name="ScaleBridge.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary_variant</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ScaleBridge.BodyText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

    <style name="ScaleBridge.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginTop">8dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="ScaleBridge.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_marginTop">8dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>
</resources>
